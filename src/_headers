# Cloudflare Pages response headers. Pages already adds X-Content-Type-Options.
/*
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Referrer-Policy: strict-origin-when-cross-origin

# Content-hashed via ?v= in templates, so safe to cache for a year.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Font files are renamed if they ever change, so safe to cache for a year.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed (linked from schema and shared externally), so cache for a day.
/assets/brand/*
  Cache-Control: public, max-age=86400

# Only the custom domain should be indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
